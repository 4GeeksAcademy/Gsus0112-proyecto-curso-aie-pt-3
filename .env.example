# Copia este archivo a .env en la raiz del repo (docker compose lo lee automaticamente).
# NUNCA subas .env a Git.

# Supabase PostgreSQL Connection (Connect -> Direct -> Transaction pooler -> URI, port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Autenticacion JWT (TinyDB)
SECRET_KEY=change-this-secret-in-local-env
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30

# Correo de recuperacion (opcional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3001
RESET_PASSWORD_URL=http://localhost:3001/reset-password

# Docker: development (next dev + --reload) | production (lo fija docker-compose.prod.yml)
APP_MODE=development

# Solo si ejecutas el backoffice SIN Docker (uis/backoffice/.env.local).
# En Docker se usa /backend, que Next.js reenvia a http://api:8000.
# NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000
