# Supabase PostgreSQL Connection (Connect -> Direct -> Transaction pooler -> URI, port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Autenticación JWT (TinyDB)
SECRET_KEY=change-this-secret-in-local-env
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30

# Correo de recuperación (opcional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000
